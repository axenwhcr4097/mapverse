{
  "id": "./",
  "name": "MapVerse — Bản đồ, dẫn đường, cảnh báo lũ",
  "short_name": "MapVerse",
  "description": "Bản đồ 3D, dẫn đường bằng giọng nói, bản đồ ngoại tuyến và cảnh báo lũ.",
  "lang": "vi",
  "start_url": "./?src=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#050505",
  "theme_color": "#050505",
  "categories": ["navigation", "travel", "weather"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chỉ đường", "url": "./?tab=route", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Cảnh báo lũ", "url": "./?tab=flood", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ngoại tuyến", "url": "./?tab=offline", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
